{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.tsx"],
  "project": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.spec.{ts,tsx}"
  ],
  "ignore": ["src/react-app-env.d.ts"],
  "ignoreDependencies": ["@testing-library/user-event", "fake-indexeddb"],
  "jest": {
    "entry": [
      "src/setupTests.ts",
      "src/**/*.test.{ts,tsx}",
      "src/**/*.spec.{ts,tsx}"
    ]
  }
}
